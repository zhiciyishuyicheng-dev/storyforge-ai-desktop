{
  "name": "story-to-screen-studio",
  "productName": "StoryForge AI 短剧工坊",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && node scripts/desktop-pack.cjs --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "com.storyforge.desktop",
    "productName": "StoryForge AI 短剧工坊",
    "directories": {
      "output": "release-v1.0.1"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "StoryForge-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StoryForge AI 短剧工坊"
    }
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299"
  },
  "description": "StoryForge AI 短剧工坊：从故事、分镜和参考图到批量视频的 Windows 桌面应用",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhiciyishuyicheng-dev/storyforge-ai-desktop.git"
  }
}
